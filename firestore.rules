rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Firebase profiles: self-read; ADMIN can manage profiles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.active is bool
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.username is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Operational handover data is no longer public.
    match /sags_handovers/{document=**} {
      allow read, create, update: if activeUser();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
